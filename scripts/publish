#!/usr/bin/env python3

from datetime import datetime
from pathlib import Path
import subprocess


def get_version(root_dir: Path) -> str:
    kwargs = {"cwd": root_dir, "check": True, "capture_output": True, "text": True}
    return subprocess.run(["uv", "version", "--short"], **kwargs).stdout.strip()


def set_version(root_dir: Path, new_ver: str) -> None:
    kwargs = {"cwd": root_dir, "check": True, "capture_output": True, "text": True}
    subprocess.run(["uv", "version", new_ver], **kwargs)


def update_version(current_version: str) -> str:
    now = datetime.now()
    year = now.year
    month = now.month
    parts = current_version.split(".")

    if len(parts) != 3:
        raise ValueError(f"Invalid current version: {current_version}")
    current_build = int(parts[2])
    if parts[0] == str(year) and parts[1] == str(month):
        next_build = current_build + 1
    else:
        next_build = 0

    return f"{year}.{month}.{next_build}"


def tag_version(root_dir: Path, new_ver: str) -> None:
    kwargs = {"cwd": root_dir, "check": True, "capture_output": True, "text": True}
    tag_name = f"v{new_ver}"

    branch = subprocess.run(["git", "branch", "--show-current"], **kwargs).stdout.strip()
    if branch != "main":
        raise ValueError(f"Not on main branch: {branch}")

    status = subprocess.run(["git", "status", "--porcelain"], **kwargs).stdout.strip()
    if status:
        raise ValueError(f"Working tree not clean:\n{status}")

    subprocess.run(["git", "tag", tag_name], **kwargs)
    subprocess.run(["git", "push", "origin", tag_name], **kwargs)


def main():
    root_dir = Path(__file__).parent.parent.resolve()
    current_ver = get_version(root_dir)
    new_ver = update_version(current_ver)

    set_version(root_dir, new_ver)
    tag_version(root_dir, new_ver)


if __name__ == "__main__":
    main()
